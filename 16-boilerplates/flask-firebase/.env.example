# Flask settings
FLASK_SECRET_KEY=change-this-to-a-random-string
FLASK_DEBUG=true

# Firebase Admin SDK credentials (download from Firebase Console)
# Project Settings → Service accounts → Generate new private key
FIREBASE_CREDENTIALS=serviceAccountKey.json

# Firebase Web Config (used in HTML templates)
# Get these from Project Settings → General → Your apps
FIREBASE_API_KEY=your-api-key-here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=your-app-id-here
